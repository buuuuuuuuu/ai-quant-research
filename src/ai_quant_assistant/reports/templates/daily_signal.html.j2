<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>日线信号策略报告</title>
<style>body{font-family:system-ui,sans-serif;margin:auto;max-width:1120px;padding:24px;color:#173126;overflow-wrap:anywhere}table{border-collapse:collapse;width:100%;font-size:14px}th,td{border:1px solid #d8e0da;padding:8px;text-align:left;vertical-align:top}th{background:#eef4ef}.scroll{max-width:100%;overflow-x:auto}code,pre{white-space:pre-wrap;overflow-wrap:anywhere}.notice{padding:12px;background:#fff6d9;border-left:4px solid #b28214}details{margin:16px 0}.summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.summary div{padding:10px;background:#eef4ef}.summary dt{font-size:12px;color:#52635a}.summary dd{margin:4px 0}@media(max-width:768px){.summary{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){body{padding:12px}h1{font-size:1.5rem}.summary{grid-template-columns:1fr}}</style></head><body>
<h1>因子选股与日线技术信号策略报告</h1>
<p class="notice">信号在交易日收盘后确认，指令最早在下一交易日开盘尝试执行。日线数据不能证明开盘集合竞价的真实成交量；触及价格限制时采用保守阻断。</p>
<h2>策略摘要</h2><dl class="summary"><div><dt>研究区间</dt><dd>{{ spec.start_date }} 至 {{ spec.end_date }}</dd></div><div><dt>冻结范围</dt><dd>{{ spec.symbols|length }} 只股票</dd></div><div><dt>候选更新</dt><dd>{{ spec.candidate_refresh|enum_label }}</dd></div><div><dt>候选数量 / 最大持仓</dt><dd>{{ spec.candidate_count }} / {{ spec.max_positions }}</dd></div><div><dt>信号口径</dt><dd>{{ spec.adjustment|enum_label }}收盘确认</dd></div><div><dt>执行口径</dt><dd>下一交易日未复权开盘尝试</dd></div></dl>
<h3>候选排序因子</h3><ul>{% for item in spec.candidate_factors %}<li>{{ item.code|factor_label }} · {{ item.direction|enum_label }} · 相对权重 {{ item.weight }}</li>{% endfor %}</ul>
<h3>买入规则（{{ spec.buy_rule_mode|enum_label }}）</h3><ul>{% for item in spec.buy_rules %}<li>{{ item|rule_label }}</li>{% endfor %}</ul>
<h3>卖出规则（{{ spec.sell_rule_mode|enum_label }}）</h3><ul>{% for item in spec.sell_rules %}<li>{{ item|rule_label }}</li>{% endfor %}</ul>
<h2>结果摘要</h2><div class="scroll"><table><tbody>{% for k,v in metrics.items() %}<tr><th>{{ k|field_label }}</th><td>{{ v if v is not none else '未记录' }}</td></tr>{% endfor %}</tbody></table></div>
<h2>信号明细（最近 80 条）</h2><div class="scroll"><table><thead><tr><th>信号日</th><th>股票</th><th>动作</th><th>状态</th><th>候选排名 / 得分</th><th>信号价</th><th>计划执行日</th><th>规则与依据</th></tr></thead><tbody>{% for r in signals %}<tr><td>{{ r.signal_date }}</td><td>{{ r.symbol }}</td><td>{{ r.action|enum_label }}</td><td>{{ r.status|enum_label }}</td><td>{{ r.candidate_rank if r.candidate_rank is not none else '未记录' }} / {{ r.candidate_score if r.candidate_score is not none else '未记录' }}</td><td>{{ r.signal_price if r.signal_price is not none else '未记录' }}</td><td>{{ r.planned_execution_date if r.planned_execution_date is not none else '回测结束后' }}</td><td>{{ r.rule_summary }}<details><summary>原始触发依据</summary><code>{{ r.rule_evidence }}</code></details></td></tr>{% else %}<tr><td colspan="8">没有生成信号；不显示为零收益交易。</td></tr>{% endfor %}</tbody></table></div>
<h2>订单与成交（最近 80 条）</h2><div class="scroll"><table><thead><tr><th>计划执行日</th><th>实际日期</th><th>股票</th><th>方向</th><th>状态</th><th>数量</th><th>开盘参考成交价</th><th>原因 / 后续处理</th></tr></thead><tbody>{% for r in orders %}<tr><td>{{ r.planned_execution_date }}</td><td>{{ r.execution_date }}</td><td>{{ r.symbol }}</td><td>{{ r.side|enum_label }}</td><td>{{ r.status|enum_label }}</td><td>{{ r.shares }}</td><td>{{ r.execution_price if r.execution_price is not none else '未记录' }}</td><td>{{ r.reason|enum_label if r.reason else '-' }} / {{ r.next_action|enum_label if r.next_action else '-' }}</td></tr>{% else %}<tr><td colspan="8">没有订单尝试记录。</td></tr>{% endfor %}</tbody></table></div>
<details><summary>完整策略参数</summary><pre>{{ spec|tojson(indent=2) }}</pre></details><details><summary>数据与执行限制</summary><pre>{{ diagnostics|tojson(indent=2) }}</pre></details>
</body></html>
