# Install as /etc/ai-quant/ai-quant.env with permissions 0600.
# Configure both values before starting ai-quant-web.service.
AI_QUANT_WEB_USERNAME=admin
AI_QUANT_WEB_PASSWORD=
AI_QUANT_WEB_SESSION_SECRET=
AI_QUANT_WEB_SESSION_SECURE=false
AI_QUANT_WEB_SESSION_TTL_SECONDS=43200

# Production systemd services run as ai-quant and cannot access /root.
AI_QUANT_DATA_DIR=/var/lib/ai-quant/data
AI_QUANT_DUCKDB_PATH=/var/lib/ai-quant/data/catalog.duckdb
AI_QUANT_ARTIFACT_DIR=/var/lib/ai-quant/artifacts
AI_QUANT_BACKUP_DIR=/var/lib/ai-quant/backups
AI_QUANT_BACKUP_RETENTION_DAYS=30
AI_QUANT_BACKUP_MINIMUM_COUNT=7

# Leave this empty to synchronize the active symbols already in security_master.
AI_QUANT_SYNC_SYMBOLS=
AI_QUANT_SYNC_LOOKBACK_DAYS=7
AI_QUANT_SYNC_ANNOUNCEMENT_LOOKBACK_DAYS=120
AI_QUANT_SYNC_FINANCIAL_LOOKBACK_DAYS=400
AI_QUANT_SYNC_BENCHMARK=csi000300
AI_QUANT_DATA_SYNC_RATE_LIMIT_SECONDS=0.2
AI_QUANT_ALERT_SYNC_STALE_HOURS=48
AI_QUANT_ALERT_BACKUP_STALE_HOURS=36
AI_QUANT_ALERT_DISK_FREE_PERCENT=10
AI_QUANT_ALERT_LOGIN_FAILURE_THRESHOLD=5
# Optional HTTPS endpoint for Enterprise WeChat, DingTalk, or a custom alert receiver.
AI_QUANT_ALERT_WEBHOOK_URL=
AI_QUANT_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
AI_QUANT_LOG_LEVEL=INFO
