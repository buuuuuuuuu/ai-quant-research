[Unit]
Description=AI Quant Research Web Workbench
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ai-quant
Group=ai-quant
WorkingDirectory=/opt/ai-quant/app
EnvironmentFile=/etc/ai-quant/ai-quant.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sh -c 'test -n "$AI_QUANT_WEB_PASSWORD" && test -n "$AI_QUANT_WEB_SESSION_SECRET"'
ExecStartPre=/usr/bin/env /opt/ai-quant/app/.venv/bin/ai-quant data init
ExecStart=/usr/bin/env /opt/ai-quant/app/.venv/bin/uvicorn ai_quant_assistant.api.app:create_app --factory --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
StateDirectory=ai-quant
ReadWritePaths=/var/lib/ai-quant

[Install]
WantedBy=multi-user.target
