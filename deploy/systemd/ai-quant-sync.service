[Unit]
Description=AI Quant Incremental Market and Financial Data Synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ai-quant
Group=ai-quant
WorkingDirectory=/opt/ai-quant/app
EnvironmentFile=/etc/ai-quant/ai-quant.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env /opt/ai-quant/app/.venv/bin/ai-quant ops sync
TimeoutStartSec=7200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
StateDirectory=ai-quant
ReadWritePaths=/var/lib/ai-quant
