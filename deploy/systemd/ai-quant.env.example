# Install as /etc/ai-quant/ai-quant.env with permissions 0600.
# Configure both values before starting ai-quant-web.service.
AI_QUANT_WEB_USERNAME=admin
AI_QUANT_WEB_PASSWORD=
AI_QUANT_WEB_SESSION_SECRET=
AI_QUANT_WEB_SESSION_SECURE=false
AI_QUANT_WEB_SESSION_TTL_SECONDS=43200

# Leave database paths unset to reuse the automatic catalog selection.
# AI_QUANT_DATA_DIR=/root/code/ai-quant-research/data/data
# AI_QUANT_DUCKDB_PATH=/root/code/ai-quant-research/data/data/catalog.duckdb
# AI_QUANT_BACKUP_DIR=/root/code/ai-quant-research/data/data/backups

# Leave this empty to synchronize the active symbols already in security_master.
AI_QUANT_SYNC_SYMBOLS=
AI_QUANT_SYNC_LOOKBACK_DAYS=7
AI_QUANT_SYNC_ANNOUNCEMENT_LOOKBACK_DAYS=120
AI_QUANT_SYNC_FINANCIAL_LOOKBACK_DAYS=400
AI_QUANT_SYNC_BENCHMARK=csi000300
AI_QUANT_DATA_SYNC_RATE_LIMIT_SECONDS=0.2
AI_QUANT_LOG_LEVEL=INFO
