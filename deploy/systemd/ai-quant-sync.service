[Unit]
Description=AI Quant Incremental Market and Financial Data Synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/code/ai-quant-research
EnvironmentFile=/etc/ai-quant/ai-quant.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env /root/code/ai-quant-research/.venv/bin/ai-quant ops sync
TimeoutStartSec=7200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
