<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>多因子研究实验报告</title>
<style>body{font:14px Arial,"Microsoft YaHei",sans-serif;background:#eef2f5;color:#173048;margin:0}main{max-width:1240px;margin:28px auto;padding:40px;background:#fff}h1,h2{color:#173b5e}.notice{padding:14px;background:#fff7e8;border-left:4px solid #bd8d35}table{width:100%;border-collapse:collapse;margin:18px 0}th{background:#173b5e;color:white;text-align:left}th,td{padding:9px;border:1px solid #dce3e8}tr:nth-child(even){background:#f5f7fa}.selected{font-weight:bold;color:#166446}</style></head><body><main>
<h1>多因子研究与策略实验报告</h1><p>{{ spec.start_date }} 至 {{ spec.end_date }} · {{ spec.symbols|length }} 只股票 · {{ spec.factors|length }} 个财务因子</p>
<p class="notice">{{ diagnostics.survivorship_bias_warning }} 模型只根据验证集排序；测试集不得参与参数选择。财报必须在信号日 15:00 前已公开。</p>
<h2>因子设置</h2><table><thead><tr><th>因子</th><th>权重</th><th>方向</th></tr></thead><tbody>{% for row in spec.factors %}<tr><td>{{ row.code }}</td><td>{{ row.weight }}</td><td>{{ row.direction }}</td></tr>{% endfor %}</tbody></table>
<h2>IC / Rank IC 有效性</h2><table><thead><tr><th>因子</th><th>期数</th><th>IC 均值</th><th>Rank IC 均值</th><th>IC IR</th><th>正向占比</th></tr></thead><tbody>{% for row in ic_summary %}<tr><td>{{ row.factor }}</td><td>{{ row.periods }}</td><td>{{ row.mean_ic|number }}</td><td>{{ row.mean_rank_ic|number }}</td><td>{{ row.ic_ir|number }}</td><td>{{ row.positive_ic_ratio|pct }}</td></tr>{% endfor %}</tbody></table>
<h2>参数扫描与策略对比</h2><table><thead><tr><th>策略</th><th>总收益</th><th>年化</th><th>超额</th><th>最大回撤</th><th>夏普</th><th>入选</th></tr></thead><tbody>{% for row in strategies %}<tr{% if row.selected_by_validation %} class="selected"{% endif %}><td>{{ row.strategy }}</td><td>{{ row.total_return|pct }}</td><td>{{ row.annualized_return|pct }}</td><td>{{ row.excess_return|pct }}</td><td>{{ row.max_drawdown|pct }}</td><td>{{ row.sharpe_ratio|number }}</td><td>{{ "验证集最优" if row.selected_by_validation else "" }}</td></tr>{% endfor %}</tbody></table>
<h2>训练 / 验证 / 样本外</h2><table><thead><tr><th>策略</th><th>分段</th><th>日期</th><th>收益</th><th>超额</th><th>夏普</th></tr></thead><tbody>{% for row in segments if row.selected_by_validation %}<tr><td>{{ row.strategy }}</td><td>{{ row.segment }}</td><td>{{ row.start_date }} — {{ row.end_date }}</td><td>{{ row.total_return|pct }}</td><td>{{ row.excess_return|pct }}</td><td>{{ row.sharpe_ratio|number }}</td></tr>{% endfor %}</tbody></table>
<h2>年度因子稳定性</h2><table><thead><tr><th>因子</th><th>年份</th><th>期数</th><th>IC</th><th>Rank IC</th></tr></thead><tbody>{% for row in yearly %}<tr><td>{{ row.factor }}</td><td>{{ row.year }}</td><td>{{ row.periods }}</td><td>{{ row.mean_ic|number }}</td><td>{{ row.mean_rank_ic|number }}</td></tr>{% endfor %}</tbody></table>
<h2>滚动样本外验证</h2><table><thead><tr><th>策略</th><th>轮次</th><th>训练结束</th><th>测试区间</th><th>测试收益</th></tr></thead><tbody>{% for row in walk_forward %}<tr><td>{{ row.strategy }}</td><td>{{ row.fold }}</td><td>{{ row.train_end }}</td><td>{{ row.test_start }} — {{ row.test_end }}</td><td>{{ row.test_return|pct }}</td></tr>{% endfor %}</tbody></table>
</main></body></html>
