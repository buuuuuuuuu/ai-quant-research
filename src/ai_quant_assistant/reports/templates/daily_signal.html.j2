<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>日线信号策略报告</title>
<style>
:root{--ink:#173126;--green:#24523b;--benchmark:#9aafa1;--line:#d8e0da;--paper:#fffdf7;--soft:#eef4ef}*{box-sizing:border-box}body{font-family:system-ui,"PingFang SC","Microsoft YaHei",sans-serif;margin:auto;max-width:1180px;padding:24px;color:var(--ink);overflow-wrap:anywhere;background:var(--paper)}h1,h2,h3{line-height:1.25}.notice{padding:12px;background:#fff6d9;border-left:4px solid #b28214}.summary,.account{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.summary div,.account div{padding:11px;background:var(--soft);min-width:0}.summary dt,.account dt{font-size:12px;color:#52635a}.summary dd,.account dd{margin:4px 0;font-weight:650}.scroll{max-width:100%;overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{border:1px solid var(--line);padding:8px;text-align:left;vertical-align:top;white-space:nowrap}th{background:var(--soft)}code,pre{white-space:pre-wrap;overflow-wrap:anywhere}details{margin:14px 0}.term{display:inline-block;margin:.15rem}.term summary{display:inline-flex;align-items:center;gap:.3rem;cursor:pointer;list-style:none}.term summary::-webkit-details-marker{display:none}.term button{width:1.5rem;height:1.5rem;border:1px solid #91a698;border-radius:50%;background:#fff;color:var(--green);font-weight:700}.term .term-card{position:absolute;z-index:3;max-width:390px;padding:12px;border:1px solid var(--line);background:#fff;box-shadow:0 10px 35px #1731262b}.chart-wrap{position:relative;max-width:100%;overflow:hidden;border:1px solid var(--line);background:#fff;padding:8px}.chart-wrap svg{display:block;width:100%;height:auto;min-height:260px}.grid{stroke:#e3e9e4;stroke-width:1}.axis{stroke:#66776d;stroke-width:1.2}.tick{fill:#52635a;font-size:11px}.strategy{fill:none;stroke:var(--green);stroke-width:3}.benchmark{fill:none;stroke:var(--benchmark);stroke-width:2;stroke-dasharray:8 5}.legend{display:flex;gap:18px;flex-wrap:wrap;justify-content:flex-end;background:#ffffffde;padding:7px 10px;border:1px solid var(--line);font-size:12px}.legend i{display:inline-block;width:28px;margin-right:7px;vertical-align:middle;border-top:3px solid var(--green)}.legend .benchmark-key{border-top:2px dashed var(--benchmark)}.muted{color:#52635a;font-size:12px}@media(max-width:768px){.summary,.account{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){body{padding:12px}h1{font-size:1.5rem}.summary,.account{grid-template-columns:1fr}.chart-wrap svg{min-width:680px}.chart-wrap{overflow-x:auto}.term .term-card{position:static;max-width:none}}
.audit-ok{padding:12px;border-left:5px solid #2d7a50;background:#f1faf4}.audit-warning{padding:12px;border-left:5px solid #b27b24;background:#fff8e5}.price-close{fill:none;stroke:#173b2b;stroke-width:2.7}.price-ma-1{fill:none;stroke:#2f77a5;stroke-width:2}.price-ma-2{fill:none;stroke:#c17b25;stroke-width:2;stroke-dasharray:8 4}.price-ma-other{fill:none;stroke:#8a6ca8;stroke-width:2;stroke-dasharray:3 4}.event-buy-signal{fill:#1f8150}.event-sell-signal{fill:#b84437}.event-planned{fill:#366f9e}.event-executed{fill:#173126}.event-blocked{fill:#c6922c}.source-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.source-grid div{padding:9px;background:var(--soft)}.source-grid dt{font-size:11px;color:#52635a}.source-grid dd{margin:4px 0;overflow-wrap:anywhere}@media(max-width:768px){.source-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.source-grid{grid-template-columns:1fr}}
</style></head><body>
{% macro shown(value) %}{{ value if value is not none else '未记录' }}{% endmacro %}
{% macro pct(value) %}{{ '%.2f%%'|format(value * 100) if value is number else '未记录' }}{% endmacro %}
{% macro money(value) %}{{ '%.2f'|format(value) if value is number else '未记录' }}{% endmacro %}
{% macro term(key) %}{% set t=terms[key] %}<details class="term"><summary>{{ t.label }}<button type="button" aria-label="查看{{ t.label }}解释">?</button></summary><div class="term-card"><strong>{{ t.professional }}</strong><p>{{ t.short }}</p><p><b>口径：</b>{{ t.calculation }}</p><p><b>例子：</b>{{ t.example }}</p><p><b>限制：</b>{{ t.limitations }}</p><code>{{ t.code }}</code></div></details>{% endmacro %}

<h1>因子选股与日线技术信号策略报告</h1>
<p class="notice">信号在交易日收盘后确认，指令最早在下一交易日开盘尝试执行。日线数据不能证明开盘集合竞价的真实成交量；触及价格限制时采用保守阻断。</p>
<h2>策略摘要</h2><dl class="summary"><div><dt>研究区间</dt><dd>{{ spec.start_date }} 至 {{ spec.end_date }}</dd></div><div><dt>冻结范围</dt><dd>{{ spec.symbols|length }} 只股票</dd></div><div><dt>候选更新</dt><dd>{{ spec.candidate_refresh|enum_label }}</dd></div><div><dt>候选数量 / 最大持仓</dt><dd>{{ spec.candidate_count }} / {{ spec.max_positions }}</dd></div><div><dt>信号口径</dt><dd>{{ spec.adjustment|enum_label }}收盘确认</dd></div><div><dt>执行口径</dt><dd>下一交易日未复权开盘尝试</dd></div></dl>
<p class="notice">{{ spec|daily_signal_summary }}</p>
<h2>数据完整性与研究限制</h2>
<dl class="summary"><div><dt>原股票池 / revision</dt><dd>{{ shown(trust_summary.scope.source_pool_id or trust_summary.scope.pool_id) }} / {{ shown(trust_summary.scope.source_pool_revision or trust_summary.scope.pool_revision) }}</dd></div><div><dt>研究有效交易日 / 预热起点</dt><dd>{{ shown(trust_summary.effective_trading_days) }} / {{ shown(trust_summary.warmup_start) }}</dd></div><div><dt>提交时只读预检</dt><dd>{% if trust_summary.preflight %}{{ '通过' if trust_summary.preflight.ready else '未通过' }} · {{ shown(trust_summary.preflight.checked_at) }} · 阻断 {{ shown(trust_summary.preflight.blocker_count) }}{% else %}未记录{% endif %}</dd></div><div><dt>基准覆盖</dt><dd>{{ shown(trust_summary.preflight.benchmark.status if trust_summary.preflight and trust_summary.preflight.benchmark else none) }}</dd></div><div><dt>信号 / 指令 / 成交 / 未成交</dt><dd>{{ shown(trust_summary.signal_count) }} / {{ shown(trust_summary.order_count) }} / {{ shown(trust_summary.executed_count) }} / {{ shown(trust_summary.unfilled_count) }}</dd></div><div><dt>交易成本 / 初始资金</dt><dd>{{ pct(trust_summary.cost_to_initial_capital) }}</dd></div></dl>
{% if trust_summary.scope.excluded %}<p class="notice">本次明确排除：{% for item in trust_summary.scope.excluded %}{{ item.symbol }}（{{ item.reason }}）{% if not loop.last %}；{% endif %}{% endfor %}。原范围的数据问题仍未修复。</p>{% endif %}
<details><summary>提交时逐股逐口径缺口核验</summary>{% if trust_summary.preflight and trust_summary.preflight.gap_checks %}<div class="scroll"><table><thead><tr><th>股票</th><th>口径</th><th>已核验停牌</th><th>仍无法核验</th></tr></thead><tbody>{% for item in trust_summary.preflight.gap_checks[:1000] %}<tr><td>{{ shown(item.symbol) }}</td><td>{{ shown(item.adjustment) }}</td><td>{{ shown(item.counts.verified_suspension) }}</td><td>{{ shown(item.counts.unverified_gap) }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>未记录提交时的缺口分类。</p>{% endif %}</details>
<p class="notice">{{ trust_summary.limitation }} 财务指标缺失导致的候选排除时点未可靠保存时显示“未记录”；数据完整性与策略表现应分别判断。</p>
<h2>成交、成本与回撤事实</h2><p>最大回撤区间：{{ shown(trust_summary.drawdown_period.peak_date if trust_summary.drawdown_period else none) }} 至 {{ shown(trust_summary.drawdown_period.trough_date if trust_summary.drawdown_period else none) }}；幅度 {{ pct(trust_summary.drawdown_period.magnitude if trust_summary.drawdown_period else none) }}。交易成本 / 期末净收益绝对值：{{ pct(trust_summary.cost_to_abs_net_gain) }}。区间持仓不能证明回撤的因果原因。</p>
<div class="scroll"><table><thead><tr><th>股票</th><th>买入 / 卖出笔数</th><th>买入金额</th><th>卖出金额</th><th>累计成本</th></tr></thead><tbody>{% for item in trust_summary.per_symbol %}<tr><td>{{ item.symbol }}</td><td>{{ item.buy_count }} / {{ item.sell_count }}</td><td>{{ money(item.buy_notional) }}</td><td>{{ money(item.sell_notional) }}</td><td>{{ money(item.total_cost) }}</td></tr>{% else %}<tr><td colspan="5">没有实际成交记录。</td></tr>{% endfor %}</tbody></table></div><p>未成交不计入金额。完整事实摘要见 trust_summary.json；单笔盈亏及股票收益贡献尚无可靠成本基础，显示“未记录”。</p>
<h3>候选排序因子 {{ term('factor_weight') }}</h3><ul>{% for item in spec.candidate_factors %}<li>{{ item.code|factor_label }} · {{ item.direction|enum_label }} · 相对权重 {{ item.weight }}</li>{% endfor %}</ul>
<h3>买入规则 {{ term('ma_state') }} {{ term('ma_cross') }}</h3><ul>{% for item in spec.buy_rules %}<li>{{ item|rule_label }}</li>{% endfor %}</ul>
<h3>卖出规则（{{ spec.sell_rule_mode|enum_label }}）</h3><ul>{% for item in spec.sell_rules %}<li>{{ item|rule_label }}</li>{% endfor %}</ul>

<h2>净值走势 {{ term('nav') }} {{ term('benchmark') }}</h2>
{% if nav_chart.x_ticks %}<div class="legend" aria-label="图例"><span><i></i>策略累计净值</span><span><i class="benchmark-key"></i>基准累计净值</span></div><div class="chart-wrap"><svg role="img" aria-label="策略与基准累计净值，横轴日期，纵轴累计净值" viewBox="0 0 {{ nav_chart.width }} {{ nav_chart.height }}">
{% for tick in nav_chart.y_ticks %}<line class="grid" x1="{{ nav_chart.plot.left }}" x2="{{ nav_chart.plot.right }}" y1="{{ tick.y }}" y2="{{ tick.y }}"/><text class="tick" text-anchor="end" x="{{ nav_chart.plot.left - 8 }}" y="{{ tick.y + 4 }}">{{ tick.label }}</text>{% endfor %}
<line class="axis" x1="{{ nav_chart.plot.left }}" x2="{{ nav_chart.plot.right }}" y1="{{ nav_chart.plot.bottom }}" y2="{{ nav_chart.plot.bottom }}"/><line class="axis" x1="{{ nav_chart.plot.left }}" x2="{{ nav_chart.plot.left }}" y1="{{ nav_chart.plot.top }}" y2="{{ nav_chart.plot.bottom }}"/>
{% for tick in nav_chart.x_ticks %}<line class="grid" x1="{{ tick.x }}" x2="{{ tick.x }}" y1="{{ nav_chart.plot.top }}" y2="{{ nav_chart.plot.bottom }}"/><text class="tick" text-anchor="middle" x="{{ tick.x }}" y="{{ nav_chart.plot.bottom + 23 }}">{{ tick.label }}</text>{% endfor %}
<text class="tick" text-anchor="middle" transform="translate(16 {{ (nav_chart.plot.top + nav_chart.plot.bottom) / 2 }}) rotate(-90)">累计净值（初始值=1.00）</text><text class="tick" text-anchor="middle" x="{{ (nav_chart.plot.left + nav_chart.plot.right) / 2 }}" y="{{ nav_chart.height - 8 }}">日期</text>
{% for points in nav_chart.segments.benchmark_nav %}<polyline class="benchmark" points="{{ points }}"/>{% endfor %}{% for points in nav_chart.segments.portfolio_nav %}<polyline class="strategy" points="{{ points }}"/>{% endfor %}</svg></div>{% else %}<p>没有可绘制的已保存净值数据。</p>{% endif %}

<h2>账户结果概览</h2>{% set a=result_view.account %}<dl class="account"><div><dt>初始资金</dt><dd>{{ money(a.initial_capital) }}</dd></div><div><dt>回测结束总资产</dt><dd>{{ money(a.final_value) }}</dd></div><div><dt>回测结束现金</dt><dd>{{ money(a.final_cash) }}</dd></div><div><dt>回测结束日持仓市值 {{ term('position_value') }}</dt><dd>{{ money(a.final_position_value) }}</dd></div><div><dt>累计收益</dt><dd>{{ pct(a.total_return) }}</dd></div><div><dt>基准收益</dt><dd>{{ pct(a.benchmark_total_return) }}</dd></div><div><dt>超额收益</dt><dd>{{ pct(a.excess_return) }}</dd></div><div><dt>最大回撤 {{ term('max_drawdown') }}</dt><dd>{{ pct(a.max_drawdown) }}</dd></div><div><dt>交易总成本 {{ term('transaction_cost') }}</dt><dd>{{ money(a.total_transaction_cost) }}</dd></div><div><dt>信号 / 指令</dt><dd>{{ shown(a.signal_count) }} / {{ shown(a.order_count) }}</dd></div><div><dt>买入 / 卖出成交</dt><dd>{{ shown(a.buy_execution_count) }} / {{ shown(a.sell_execution_count) }}</dd></div><div><dt>未成交 / 等待退出</dt><dd>{{ shown(a.unfilled_count) }} / {{ shown(a.pending_exit_count) }}</dd></div></dl>

<h2>账户审计状态</h2><div class="{{ 'audit-ok' if account_audit_summary.status == 'passed' else 'audit-warning' }}"><strong>{{ '核对通过' if account_audit_summary.status == 'passed' else '完成但有差异' if account_audit_summary.status == 'warning' else '未记录' }}</strong><p>已核对 {{ shown(account_audit_summary.checked_dates) }} 个交易日、{{ shown(account_audit_summary.check_count) }} 项；异常 {{ shown(account_audit_summary.failure_count) }} 项。金额容差：绝对 {{ shown(account_audit_summary.absolute_tolerance) }}，相对 {{ shown(account_audit_summary.relative_tolerance) }}。</p><p>{{ account_audit_summary.notice or '历史运行没有账户审计产物，不从最终结果倒推。' }}</p></div>

<details open><summary>运行可复现信息</summary><dl class="source-grid"><div><dt>运行 ID</dt><dd>{{ shown(reproducibility.run_id) }}</dd></div><div><dt>参数 SHA-256</dt><dd>{{ shown(reproducibility.parameter_sha256) }}</dd></div><div><dt>股票池 / revision</dt><dd>{{ shown(reproducibility.stock_pool_id) }} / {{ shown(reproducibility.stock_pool_revision) }}</dd></div><div><dt>冻结范围</dt><dd>{{ shown(reproducibility.frozen_symbol_count) }} 只 · {{ shown(reproducibility.frozen_symbols_sha256) }}</dd></div><div><dt>技术指标预热起点</dt><dd>{{ shown(reproducibility.technical_warmup_start) }}</dd></div><div><dt>输入读取时间</dt><dd>{{ shown(reproducibility.input_read_at) }}</dd></div><div><dt>应用 / Git</dt><dd>{{ shown(reproducibility.application_version) }} / {{ shown(reproducibility.git_commit_sha) }}</dd></div><div><dt>Schema / 时区</dt><dd>{{ shown(reproducibility.schema_version) }} / {{ shown(reproducibility.timezone) }}</dd></div><div><dt>执行规则 / 报告</dt><dd>{{ shown(reproducibility.execution_rule_version) }} / {{ shown(reproducibility.report_template_version) }}</dd></div></dl><p class="muted">{{ reproducibility.limitation or '历史运行缺少的来源字段显示为未记录。' }}</p></details>

<h2>价格、MA 与信号</h2><p class="notice">价格与均线使用 {{ shown(price_chart.price_adjustment) }} 信号口径。成交开盘参考价为未复权口径，只按日期显示事件，不绘制到同一价格轴。</p>{% if price_chart.segments %}<div class="legend"><span>股票 {{ price_chart.symbol }}</span>{% for key in price_chart.line_keys %}<span>{{ '信号收盘价' if key == 'signal_close' else key|upper }}</span>{% endfor %}<span>圆点：信号、计划、成交或受限日期</span></div><div class="chart-wrap"><svg role="img" aria-label="股票价格、移动平均线和交易事件" viewBox="0 0 {{ price_chart.width }} {{ price_chart.height }}">{% for tick in price_chart.y_ticks %}<line class="grid" x1="{{ price_chart.plot.left }}" x2="{{ price_chart.plot.right }}" y1="{{ tick.y }}" y2="{{ tick.y }}"/><text class="tick" text-anchor="end" x="{{ price_chart.plot.left - 8 }}" y="{{ tick.y + 4 }}">{{ tick.label }}</text>{% endfor %}<line class="axis" x1="{{ price_chart.plot.left }}" x2="{{ price_chart.plot.right }}" y1="{{ price_chart.plot.bottom }}" y2="{{ price_chart.plot.bottom }}"/><line class="axis" x1="{{ price_chart.plot.left }}" x2="{{ price_chart.plot.left }}" y1="{{ price_chart.plot.top }}" y2="{{ price_chart.plot.bottom }}"/>{% for tick in price_chart.x_ticks %}<text class="tick" text-anchor="middle" x="{{ tick.x }}" y="{{ price_chart.height - 5 }}">{{ tick.label }}</text>{% endfor %}{% for key, chunks in price_chart.segments.items() %}{% set line_class='price-close' if key == 'signal_close' else 'price-ma-1' if loop.index == 2 else 'price-ma-2' if loop.index == 3 else 'price-ma-other' %}{% for points in chunks %}<polyline class="{{ line_class }}" points="{{ points }}"/>{% endfor %}{% endfor %}{% for marker in price_chart.markers %}<circle class="event-{{ marker.kind }}" cx="{{ marker.x }}" cy="{{ marker.y }}" r="5"><title>{{ marker.kind }} · {{ marker.date }}</title></circle>{% endfor %}</svg></div>{% else %}<p>该运行没有可绘制的价格指标产物；不会读取当前行情补画历史。</p>{% endif %}

<h2>实际成交明细 {{ term('execution') }}</h2><div class="scroll"><table><thead><tr><th>信号日</th><th>计划执行日</th><th>实际成交日</th><th>股票</th><th>动作</th><th>数量（股）</th><th>信号收盘价</th><th>开盘参考价</th><th>成交金额</th><th>总成本</th><th>成交前 / 后现金</th><th>成交前 / 后持仓</th><th>佣金 / 滑点 / 印花税</th><th>关联信号</th><th>状态 / 后续</th></tr></thead><tbody>{% for r in result_view.executed %}<tr><td>{{ shown(r.signal_date) }}</td><td>{{ shown(r.planned_execution_date) }}</td><td>{{ shown(r.execution_date) }}</td><td>{{ shown(r.symbol) }}</td><td>{{ r.side|enum_label }}</td><td>{{ shown(r.shares) }}</td><td>{{ shown(r.signal_price) }}</td><td>{{ shown(r.execution_price) }}</td><td>{{ money(r.notional) }}</td><td>{{ money(r.cost) }}</td><td>{{ money(r.cash_before) }} → {{ money(r.cash_after) }}</td><td>{{ shown(r.position_shares_before) }} → {{ shown(r.position_shares_after) }}</td><td>{{ money(r.commission_cost) }} / {{ money(r.slippage_cost) }} / {{ money(r.stamp_duty_cost) }}</td><td>{{ shown(r.signal_id) }}</td><td>{{ r.status|enum_label }} / {{ r.next_action|enum_label if r.next_action else '未记录' }}</td></tr>{% else %}<tr><td colspan="15">没有已保存的实际模拟成交；未成交不会放入本表。</td></tr>{% endfor %}</tbody></table></div>

<h2>回测结束日持仓</h2><div class="scroll"><table><thead><tr><th>股票</th><th>数量（股）</th><th>回测结束日估值价格</th><th>回测结束日持仓市值</th><th>占期末总资产</th><th>候选排名 / 得分</th><th>等待退出</th></tr></thead><tbody>{% for r in result_view.final_positions %}<tr><td>{{ shown(r.symbol) }}</td><td>{{ shown(r.shares) }}</td><td>{{ shown(r.price) }}</td><td>{{ shown(r.market_value) }}</td><td>{{ pct(r.asset_ratio) }}</td><td>{{ shown(r.candidate_rank) }} / {{ shown(r.candidate_score) }}</td><td>{{ '是' if r.pending_exit is sameas true else '否' if r.pending_exit is sameas false else '未记录' }}</td></tr>{% else %}<tr><td colspan="7">没有已保存的期末持仓。</td></tr>{% endfor %}</tbody></table></div>

<h2>未成交与等待退出 {{ term('unfilled') }} {{ term('t_plus_one') }}</h2><div class="scroll"><table><thead><tr><th>股票</th><th>动作</th><th>信号日</th><th>计划执行日</th><th>计划/记录数量</th><th>原因</th><th>状态</th><th>是否失效</th><th>是否重试</th><th>后续处理</th></tr></thead><tbody>{% for r in result_view.unfilled %}<tr><td>{{ shown(r.symbol) }}</td><td>{{ r.side|enum_label }}</td><td>{{ shown(r.signal_date) }}</td><td>{{ shown(r.planned_execution_date) }}</td><td>{{ shown(r.shares) }}</td><td>{{ r.reason|enum_label if r.reason else '未记录' }}</td><td>{{ r.status|enum_label }}</td><td>{{ '是' if r.next_action == 'expired' else '否' }}</td><td>{{ '是' if r.next_action == 'retry_next_trading_day' else '否' }}</td><td>{{ r.next_action|enum_label if r.next_action else '未记录' }}</td></tr>{% else %}<tr><td colspan="10">没有未成交或等待重试的已保存指令。</td></tr>{% endfor %}</tbody></table></div>

<h2>信号 → 指令 → 成交或未成交（最近 80 条订单）</h2><div class="scroll"><table><thead><tr><th>信号</th><th>候选与规则</th><th>计划执行</th><th>实际结果</th><th>后续处理</th></tr></thead><tbody>{% for item in timeline %}{% set s=item.signal %}{% set o=item.order %}<tr><td>{{ o.side|enum_label }} · {{ o.signal_date }}<br>{{ o.symbol }} · 信号价 {{ s.signal_price if s and s.signal_price is not none else o.signal_price if o.signal_price is not none else '未记录' }}</td><td>资格 {{ s.candidate_eligible if s and s.candidate_eligible is not none else '未记录' }} · 排名 {{ s.candidate_rank if s and s.candidate_rank is not none else o.candidate_rank if o.candidate_rank is not none else '未记录' }}{% if s %}<br>{{ s.rule_summary }}<details><summary>原始触发依据</summary><code>{{ s.rule_evidence }}</code></details>{% else %}<br>未保存可关联的信号预览；不从当前参数反推。{% endif %}</td><td>{{ o.planned_execution_date }}</td><td>{{ o.status|enum_label }}<br>日期 {{ shown(o.execution_date) }} · 开盘参考价 {{ shown(o.execution_price) }} · 数量 {{ shown(o.shares) }}<br>{{ o.reason|enum_label if o.reason else '未保存未成交原因' }}</td><td>{{ o.next_action|enum_label if o.next_action else '未记录' }}</td></tr>{% else %}<tr><td colspan="5">没有订单记录；不显示为虚构的成交或零收益。</td></tr>{% endfor %}</tbody></table></div>

<details><summary>每日账户变化（最近 80 个已保存交易日）</summary><div class="scroll"><table><thead><tr><th>日期</th><th>现金</th><th>持仓市值</th><th>账户总资产</th><th>策略累计净值</th><th>基准累计净值</th><th>累计交易成本</th></tr></thead><tbody>{% for r in result_view.daily_accounts %}<tr><td>{{ shown(r.date) }}</td><td>{{ shown(r.cash) }}</td><td>{{ shown(r.position_value) }}</td><td>{{ shown(r.portfolio_value) }}</td><td>{{ shown(r.portfolio_nav) }}</td><td>{{ shown(r.benchmark_nav) }}</td><td>{{ shown(r.total_cost) }}</td></tr>{% endfor %}</tbody></table></div><p class="muted">完整记录请使用 daily_nav.csv 或 Excel 下载。</p></details>
<details><summary>每日账户核对（最近 100 项）</summary><div class="scroll"><table><thead><tr><th>日期</th><th>检查项</th><th>状态</th><th>期望</th><th>实际</th><th>差异</th><th>容差</th></tr></thead><tbody>{% for r in account_audit_rows %}<tr><td>{{ shown(r.date) }}</td><td>{{ shown(r.check) }}</td><td>{{ shown(r.status) }}</td><td>{{ shown(r.expected_value) }}</td><td>{{ shown(r.actual_value) }}</td><td>{{ shown(r.difference) }}</td><td>{{ shown(r.tolerance) }}</td></tr>{% else %}<tr><td colspan="7">旧运行没有账户审计产物。</td></tr>{% endfor %}</tbody></table></div><p class="muted">完整机器可读结果见 account_audit.csv/json；来源信息见 reproducibility.json，价格指标见 indicator_series.csv。</p></details>
<details><summary>完整策略参数</summary><pre>{{ spec|tojson(indent=2) }}</pre></details><details><summary>数据与执行限制</summary><pre>{{ diagnostics|tojson(indent=2) }}</pre></details>
</body></html>
